# Template for secrets.env.1password (gitignored). Copy it and point each
# line at your own secret store:
#
#   cp secrets.env.1password.example secrets.env.1password
#
# With 1Password, each value is an `op://<vault>/<item>/<field>` reference
# that `op run --env-file=secrets.env.1password -- ...` resolves at runtime.
# Without 1Password, put the same variable names with real values in a
# gitignored `.env` instead (see README.md, "Secrets").
#
# The variable names are the contract: config.toml refers to them as ${NAME}.
# Add, remove or rename lines to match the profiles in your config.toml.

# Password of the SurrealDB database user the indexer signs in as.
# The indexer reads SURREAL_PASSWORD directly; no config placeholder needed.
SURREAL_PASSWORD="op://Canton Toolbox/surrealdb/password"

# Keycloak client secret for a devnet profile (client_credentials grant)
DEVNET_CLIENT_SECRET="op://Canton Toolbox/devnet/client_secret"

# Keycloak client secret for a mainnet profile (client_credentials grant)
MAINNET_CLIENT_SECRET="op://Canton Toolbox/mainnet/client_secret"

# Keycloak user password for a profile using the password grant (optional)
# MAINNET_USER_PASSWORD="op://Canton Toolbox/mainnet-user/password"
